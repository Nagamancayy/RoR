{
  "name": "real-or-random-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs dev",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src tests scripts *.ts *.json *.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:production": "node scripts/smoke-production.mjs",
    "setup": "tsx scripts/setup.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "dev:web": "next dev --hostname 127.0.0.1",
    "start:web": "next start --hostname 127.0.0.1",
    "worker": "tsx scripts/worker.ts",
    "test:modifvigne": "tsx scripts/check-modifvigne.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.0",
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.7.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
