# 32-byte master key as 64 hex characters or canonical base64. Never commit a real key.
# Development automatically persists a private key in data/.master-key.
# Production requires this variable. Reuse the development key to read the same database.
ROR_MASTER_KEY=
DATABASE_URL=file:./data/ror.db
ROR_UNSAFE_DEBUG_SECRETS=false

# Server-only API credential. Never use NEXT_PUBLIC_ for this key.
OPENAI_API_KEY=
# Your supported Responses API model ID. Also selectable per batch in the UI.
OPENAI_ADVERSARY_MODEL=
